{
  "name": "notification-kit",
  "version": "2.1.2",
  "description": "One API for push, in-app, and local notifications across Web, iOS, and Android.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.esm.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.esm.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AI-INTEGRATION-GUIDE.md",
    "!**/CLAUDE.md",
    "!**/AGENTS.md"
  ],
  "bin": {
    "notification-kit-setup": "bin/setup.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "format:check": "prettier --check src/**/*.{ts,tsx}",
    "prepare": "",
    "prepublishOnly": "yarn build && yarn lint"
  },
  "keywords": [
    "capacitor",
    "react",
    "notifications",
    "push-notifications",
    "local-notifications",
    "in-app-notifications",
    "firebase",
    "onesignal",
    "typescript",
    "ios",
    "android",
    "web"
  ],
  "author": {
    "name": "Ahsan Mahmood",
    "email": "aoneahsan@gmail.com",
    "url": "https://aoneahsan.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/notification-kit.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/notification-kit/issues"
  },
  "homepage": "https://notification-kit-docs.aoneahsan.com",
  "funding": {
    "type": "individual",
    "url": "https://aoneahsan.com/payment?project-id=notification-kit&project-identifier=notification-kit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/local-notifications": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    },
    "@capacitor/push-notifications": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-onesignal": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.3.4",
    "@capacitor/local-notifications": ">=8.2.0",
    "@capacitor/preferences": ">=8.0.1",
    "@capacitor/push-notifications": ">=8.1.1",
    "firebase": ">=12.13.0",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "react-onesignal": ">=3.5.3"
  },
  "devDependencies": {
    "@capacitor/core": "^8.4.0",
    "@capacitor/local-notifications": ">=8.2.0",
    "@capacitor/preferences": ">=8.0.1",
    "@capacitor/push-notifications": ">=8.1.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": ">=12.13.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-onesignal": ">=3.5.3",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
